#!/usr/bin/env bash
# Runs everything CI would run. There is no CI runner during 0.x (cabledrawer 17 Oct),
# so run this before every pull request and paste the summary into the description.
#
#   ./check
#
# Each step's full output goes to .check/logs/<step>.log. The script fails if any
# step fails or isn't set up yet, and ends with a pass/fail summary.

set -uo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
LOGS="$ROOT/.check/logs"
IMAGE="mealwright:check"

# npm: no security-audit upload of the package list (osv-scanner covers it), no check
# for newer npm versions, no funding messages. See docs/dev/dev-tools-privacy.md.
export NPM_CONFIG_AUDIT=false NPM_CONFIG_UPDATE_NOTIFIER=false NPM_CONFIG_FUND=false

# Scanner versions (cabledrawer 17 Oct; spec section 9). Pinned exactly; releases at least
# two weeks old when chosen. uvx tools also ignore anything published after EXCLUDE_NEWER,
# so their own dependencies are fixed too. Change these on purpose, in their own commit.
EXCLUDE_NEWER="2026-10-01"
PIP_AUDIT="pip-audit==2.10.1"
BANDIT="bandit==1.9.4"
OSV_SCANNER="ghcr.io/google/osv-scanner@sha256:afd838850ac1a0fcc15ff4a041dc9ba11123c3f0d2666217a5f0fcf9222b55fa"   # v2.6.0
TRIVY="aquasec/trivy@sha256:af6acf9a6b85dfe389a1941505c0ce9efef52a4719635e1a962f022a3d855daa"                     # 0.75.0
rm -rf "$ROOT/.check" && mkdir -p "$LOGS"

names=() results=() notes=() times=()

record() { names+=("$1"); results+=("$2"); notes+=("$3"); times+=("$4"); }

# step <name> <command...>: run a command, log its output, record PASS or FAIL.
step() {
  local name="$1"; shift
  local log="$LOGS/${name// /-}.log" start=$SECONDS
  printf '%-28s ' "$name"
  if (cd "$ROOT" && "$@") >"$log" 2>&1; then
    record "$name" PASS "" "$((SECONDS - start))s"
    echo "PASS"
  else
    record "$name" FAIL "see .check/logs/${name// /-}.log" "$((SECONDS - start))s"
    echo "FAIL"
    tail -n 40 "$log" | sed 's/^/    /'
  fi
}

skip() { printf '%-28s SKIP (%s)\n' "$1" "$2"; record "$1" SKIP "$2" "-"; }
not_set_up() { printf '%-28s NOT SET UP (%s)\n' "$1" "$2"; record "$1" "NOT SET UP" "$2" "-"; }

need() { command -v "$1" >/dev/null 2>&1; }

backend() { (cd backend && "$@"); }

echo "Mealwright checks: $(git -C "$ROOT" rev-parse --short HEAD 2>/dev/null || echo '?') on $(git -C "$ROOT" branch --show-current 2>/dev/null || echo '?')"
echo

# --- Backend -----------------------------------------------------------------
if need uv; then
  step "backend: sync"           backend uv sync --frozen
  step "backend: ruff format"    backend uv run --frozen ruff format --check .
  step "backend: ruff lint"      backend uv run --frozen ruff check .
  step "backend: mypy"           backend sh -c 'uv run --frozen mypy && uv run --frozen mypy --strict scripts'
  step "backend: pytest"         backend uv run --frozen pytest -q
  step "backend: licences"       backend uv run --frozen python -I scripts/check_licences.py
  step "backend: no telemetry"   backend uv run --frozen python -I scripts/check_no_telemetry.py
else
  record "backend" FAIL "uv is not installed" "-"; echo "backend                      FAIL (uv is not installed)"
fi

# --- Frontend ----------------------------------------------------------------
if [[ -f "$ROOT/frontend/package.json" ]]; then
  step "frontend: install"       sh -c 'cd frontend && npm ci --no-audit --no-fund'
  step "frontend: lint"          sh -c 'cd frontend && npm run lint'
  step "frontend: svelte-check"  sh -c 'cd frontend && npm run check'
  step "frontend: tests"         sh -c 'cd frontend && npm test'
  step "frontend: licences"      backend uv run --frozen python -I scripts/check_licences.py --npm ../frontend
else
  skip "frontend" "no frontend yet"
fi

# --- Browser tests (Playwright, headless Chromium) ------------------------------
# They start the real app on 127.0.0.1 with an empty data folder.
if [[ -f "$ROOT/e2e/package.json" ]]; then
  step "browser: install"        sh -c 'cd e2e && npm ci --no-audit --no-fund && npx playwright install chromium-headless-shell'
  step "browser: licences"       backend uv run --frozen python -I scripts/check_licences.py --npm ../e2e
  step "browser: typecheck"      sh -c 'cd e2e && npm run -s typecheck'
  step "browser: tests"          sh -c 'cd e2e && npx playwright test'
else
  skip "browser tests" "none yet"
fi

# --- Security scanners -------------------------------------------------------
# These send package names and versions to vulnerability databases (pip-audit,
# osv-scanner) or download one (Trivy). Nothing about the homelab is sent. Trivy's
# own usage data and update check are switched off (--disable-telemetry,
# --skip-version-check).
pip_audit() {
  (cd backend && uv export -q --frozen --all-groups --no-emit-project \
     --format requirements-txt -o "$ROOT/.check/requirements.txt") &&
  uvx -q --exclude-newer "$EXCLUDE_NEWER" "$PIP_AUDIT" -r "$ROOT/.check/requirements.txt" \
    --require-hashes --disable-pip --progress-spinner off
}

if need uv; then
  step "pip-audit"               pip_audit
  step "bandit"                  uvx -q --exclude-newer "$EXCLUDE_NEWER" "$BANDIT" -q -r backend/src backend/scripts
else
  record "pip-audit, bandit" FAIL "uv is not installed" "-"
fi
if need docker; then
  # Every lock file in the repo; the repo is mounted read-only.
  lockfiles=(--lockfile /src/backend/uv.lock)
  for lock in e2e/package-lock.json frontend/package-lock.json; do
    [[ -f "$ROOT/$lock" ]] && lockfiles+=(--lockfile "/src/$lock")
  done
  step "osv-scanner"             docker run --rm -v "$ROOT:/src:ro" "$OSV_SCANNER" \
                                   scan source "${lockfiles[@]}"
else
  record "osv-scanner" FAIL "docker is not installed" "-"
fi

# --- Docker image ------------------------------------------------------------
if [[ -f "$ROOT/Dockerfile" ]]; then
  step "image: build"            docker build -t "$IMAGE" .
  step "image: no telemetry"     docker run --rm -v "$ROOT/backend/scripts:/scripts:ro" \
                                   --entrypoint python "$IMAGE" -I /scripts/check_no_telemetry.py
  # Trivy reads an exported copy of the image and gets no access to Docker itself.
  step "image: export"           docker save "$IMAGE" -o "$ROOT/.check/image.tar"
  step "image: trivy"            docker run --rm -v "$ROOT/.check:/scan:ro" \
                                   -v mealwright-trivy-cache:/root/.cache/trivy "$TRIVY" \
                                   image --input /scan/image.tar --scanners vuln \
                                   --severity HIGH,CRITICAL --ignore-unfixed --exit-code 1 --no-progress \
                                   --disable-telemetry --skip-version-check
else
  skip "image" "no Dockerfile yet"
fi

# --- Summary -----------------------------------------------------------------
pass=0 fail=0 skipped=0 missing=0
for r in "${results[@]}"; do
  case "$r" in
    PASS) ((pass++)) ;;
    FAIL) ((fail++)) ;;
    SKIP) ((skipped++)) ;;
    *)    ((missing++)) ;;
  esac
done

echo
echo "## ./check summary"
echo
echo "Commit \`$(git -C "$ROOT" rev-parse --short HEAD 2>/dev/null || echo '?')\`, $(date -u '+%Y-%m-%d %H:%M UTC')"
echo
echo "| Step | Result | Time | Note |"
echo "|---|---|---|---|"
for i in "${!names[@]}"; do
  echo "| ${names[$i]} | ${results[$i]} | ${times[$i]} | ${notes[$i]} |"
done
echo
if ((fail == 0 && missing == 0)); then
  echo "**RESULT: PASS** ($pass passed, $skipped skipped as not applicable yet)"
  exit 0
fi
echo "**RESULT: FAIL** ($fail failed, $missing not set up, $pass passed, $skipped skipped)"
exit 1
